{
  "name": "napcat-plugin-aicat",
  "plugin": "AI Cat 二改版",
  "version": "1.4.4",
  "type": "module",
  "main": "index.mjs",
  "description": "基于原作者冷曦的 AI Cat 二次修改版 NapCat 智能助手插件，支持 AI 对话、群管理、渠道模型指令管理、生图、自定义指令、定时任务、用户检测器、历史消息查询等功能",
  "author": "余生只有凄渺",
  "napcat": {
    "tags": [
      "AI",
      "娱乐",
      "群管",
      "生图"
    ],
    "minVersion": "4.14.0",
    "homepage": "https://github.com/liyw0205/napcat-plugin-lengxi"
  },
  "dependencies": {
    "napcat-types": "0.0.9",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "linkedom": "^0.18.12",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "verify:config": "tsc -p tsconfig.verify.json --pretty false",
    "verify:proxy": "node scripts/verify-proxy-fetch.js",
    "verify:stage4": "vite build --config scripts/verify-stage4.config.ts && node tmp/stage4-verify/stage4-runtime.mjs",
    "verify:stage6": "vite build --config scripts/verify-stage6.config.ts && node tmp/stage6-verify/stage6-web-smoke.mjs",
    "verify:stage7": "vite build --config scripts/verify-stage7.config.ts && node tmp/stage7-verify/stage7-web-dom.mjs",
    "verify:stage8": "vite build --config scripts/verify-stage8.config.ts && node tmp/stage8-verify/stage8-napcat-lifecycle.mjs",
    "verify:stage9": "vite build --config scripts/verify-stage9.config.ts && node tmp/stage9-verify/stage9-provider-contracts.mjs",
    "verify:stage10": "vite build --config scripts/verify-stage10.config.ts && node tmp/stage10-verify/stage10-browser-e2e.mjs",
    "verify": "npm run verify:config && npm run typecheck && npm run verify:proxy && npm run verify:stage4 && npm run verify:stage6 && npm run verify:stage7 && npm run verify:stage8 && npm run verify:stage9 && npm run verify:stage10 && npm run build"
  }
}
