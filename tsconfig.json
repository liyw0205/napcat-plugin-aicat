{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "napcat-types/napcat-onebot/action/index": ["types/napcat-types.d.ts"],
      "napcat-types/napcat-onebot/config/config": ["types/napcat-types.d.ts"],
      "napcat-types/napcat-onebot/network/plugin-manger": ["types/napcat-types.d.ts"],
      "napcat-types/napcat-onebot/types/index": ["types/napcat-types.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
